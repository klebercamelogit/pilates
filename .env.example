SECRET_KEY=troque-isto

# --- Banco de dados ---
# DB_MODE=local -> SQLite em arquivo, zero dependência externa (localhost)
# DB_MODE=cloud -> Turso/libSQL (produção, Vercel)
DB_MODE=cloud
LOCAL_DB_PATH=local.db

# Turso (usado só quando DB_MODE=cloud)
TURSO_DATABASE_URL=https://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# --- Storage de exames ---
# STORAGE_MODE=local -> exames em disco (só desenvolvimento — filesystem
#                        do Vercel é só leitura fora de /tmp)
# STORAGE_MODE=db    -> exames como base64 numa coluna do Turso. Funciona em
#                        produção sem bucket, mas limitado a MAX_UPLOAD_BYTES_DB
#                        (padrão 3MB) por causa do limite de 4.5MB de corpo de
#                        requisição do Vercel (infraestrutura, não contornável)
# STORAGE_MODE=s3    -> bucket S3-compatible via URL pré-assinada (único modo
#                        que sustenta arquivos grandes, até 300MB)
STORAGE_MODE=s3
LOCAL_UPLOAD_DIR=instance/uploads
MAX_UPLOAD_BYTES=314572800
MAX_UPLOAD_BYTES_DB=3145728

# S3-compatible (AWS S3, Cloudflare R2, Backblaze B2) — usado só quando STORAGE_MODE=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# --- E-mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@clinica.com
# true = STARTTLS na porta 587 (padrão Gmail/Brevo/SendGrid).
# Desligue para servidores de teste locais sem TLS.
SMTP_USE_TLS=true
# true = SSL implícito na porta 465 (ignora SMTP_USE_TLS se ligado)
SMTP_USE_SSL=false

# URL do frontend, para montar links clicáveis nos e-mails (opcional).
# Se vazio, os e-mails enviam o token cru com instrução de uso via API.
FRONTEND_BASE_URL=

# --- WhatsApp Business API (Meta) — fase 2, ver README ---
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- LGPD ---
TERMO_LGPD_VERSAO_ATUAL=v1.0
